{
  "name": "powerpoint-ai-addin",
  "version": "0.1.0",
  "private": true,
  "description": "PowerPoint task pane AI assistant powered by Anthropic-compatible APIs",
  "scripts": {
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "dev": "webpack serve --mode development",
    "start": "npm run dev",
    "start:full": "npm run build:dev && concurrently \"npm run dev\" \"office-addin-debugging start manifest.xml desktop\"",
    "stop": "office-addin-debugging stop manifest.xml",
    "sideload": "office-addin-debugging stop manifest.xml; office-addin-debugging start manifest.xml desktop",
    "validate": "office-addin-manifest validate manifest.xml"
  },
  "devDependencies": {
    "@types/office-js": "^1.0.400",
    "concurrently": "^8.2.2",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "html-webpack-plugin": "^5.6.0",
    "office-addin-debugging": "^6.0.7",
    "office-addin-dev-certs": "^2.0.7",
    "office-addin-manifest": "^2.1.3",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.4.5",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.4"
  },
  "dependencies": {
    "jszip": "^3.10.1"
  }
}
